{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitt-global-crm",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Autorreferencia que OpenNext usa para su caché; el nombre debe ser el del worker.
    { "binding": "WORKER_SELF_REFERENCE", "service": "fitt-global-crm" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitt-crm",
      "database_id": "794d7b0c-05de-48d5-875d-8e1721b367c2",
      "migrations_dir": "migrations"
    }
  ],
  // El dominio sólo funciona porque fittglobal.com resuelve con los
  // nameservers de Cloudflare; el registro de crm lo crea el propio deploy.
  "routes": [{ "pattern": "crm.fittglobal.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Localizador de tiendas a las 06:00 y facturas de Siigo a las 02:00 en Bogotá (UTC-5). Ver worker.ts.
  "triggers": { "crons": ["0 11 * * *", "0 7 * * *"] }
}
