# Copia este archivo a .env antes de arrancar:  cp .env.example .env

# SQLite para desarrollo. Para PostgreSQL, cambia también el `provider`
# del datasource en prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Firma las cookies de sesión (HMAC-SHA256). GENERA UNA PROPIA antes de
# desplegar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
